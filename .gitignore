.DS_Store
.venv/
.ipynb_checkpoints/

# Raw GitSkills dataset downloaded from Hugging Face (about 13 GB). Never commit.
src/data/gitskills_data/

# Derived Parquet files written by db/*.sql (about 0.5 GB). Rebuild locally.
src/data/generated_data/

# skillsig pipeline: registry clones, stage outputs, API cache, secrets, large exports.
src/data/registry_repos/
src/data/wild_history/
src/data/genealogy/
src/data/genealogy_100/
# skill_genealogy stage outputs (rebuilt by the stages; download stores are large)
src/data/skill_genealogy/*
src/data/skill_genealogy_dev/
# viewer JSON can be large; the CSV tables stay tracked
results/skill_genealogy*/tree_viewer/
results/skill_genealogy*/staleness_viewer/
results/skill_genealogy*/repo_explorer/
results/skill_genealogy*/repo_reports/
# the language check sheet holds the team's hand labels, so it stays in git
!src/data/skill_genealogy/language_check_sample.csv
src/data/derived/
src/data/cache/
.env
results/export/*.parquet
results/annotation/*/
!results/annotation

.cursor/
# Python bytecode caches, rebuilt on every run.
__pycache__/
*.py[cod]
*.tmp

# Package metadata written by `pip install -e .`, rebuilt on every install.
*.egg-info/
# pipeline run logs
logs/
*SWE*